{
  "manifest_version": 3,
  "name": "Rot13 for Bluesky",
  "version": "1.1.0",
  "description": "Decode/encode ROT13 content directly on Bluesky.",
  "icons": {
    "128": "icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Rot13 for Bluesky",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://bsky.app/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon.svg"],
      "matches": ["https://bsky.app/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "yuri.oliveira@gmail.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
